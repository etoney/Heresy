<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Heresy</title>
    <organization>com.castledangermusic</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="license.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" rootVolumeOnly="true" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions><os-version min="11.0"/></allowed-os-versions>
    </volume-check>

    <choices-outline>
        <line choice="au"/>
        <line choice="vst3"/>
        <line choice="app"/>
    </choices-outline>

    <choice id="au" title="Audio Unit (AU)" description="For Logic Pro, GarageBand, Fender Studio Pro and other Audio Unit hosts. Installs to /Library/Audio/Plug-Ins/Components.">
        <pkg-ref id="com.castledangermusic.heresy.au"/>
    </choice>
    <choice id="vst3" title="VST3" description="For Ableton Live, Cubase, Fender Studio Pro, Reaper and other VST3 hosts. Installs to /Library/Audio/Plug-Ins/VST3.">
        <pkg-ref id="com.castledangermusic.heresy.vst3"/>
    </choice>
    <choice id="app" title="Standalone app" description="Play Heresy without a DAW. Installs to /Applications.">
        <pkg-ref id="com.castledangermusic.heresy.app"/>
    </choice>

    <pkg-ref id="com.castledangermusic.heresy.au" version="@VERSION@" onConclusion="none">heresy-au.pkg</pkg-ref>
    <pkg-ref id="com.castledangermusic.heresy.vst3" version="@VERSION@" onConclusion="none">heresy-vst3.pkg</pkg-ref>
    <pkg-ref id="com.castledangermusic.heresy.app" version="@VERSION@" onConclusion="none">heresy-app.pkg</pkg-ref>
</installer-gui-script>
